# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-from-BotFather
ALLOWED_TELEGRAM_USER_IDS=your-telegram-user-id1,your-telegram-user-id2

# Supabase Postgres (use pooler URL, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:YOUR-PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres

# Your broker/account names (comma-separated) — used in help text and validation
PORTFOLIOS=BrokerA,BrokerB,BrokerC
CURRENCIES=USD,EUR,GBP
BASE_CURRENCY=USD

# Broker screenshots — get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Update reminders (default: monthly on the 15th at 20:00 in this timezone)
REMINDER_TIMEZONE=Asia/Singapore
# Optional override for where preferences are stored
# REMINDER_STORE_PATH=/path/to/reminders.json

# query the DB every N hours (0 = off)
DB_KEEPALIVE_HOURS=4
